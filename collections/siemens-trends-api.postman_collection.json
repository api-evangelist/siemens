          "request": {
            "name": "Get Point Historical Trend Data",
            "description": {
              "content": "Returns historical trend data for a building data point over a specified time range. Data is returned as timestamped value pairs.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "points",
                ":pointId",
                "trends"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [
                {
                  "disabled": false,
                  "key": "from",
                  "value": "<dateTime>",
                  "description": "(Required) Start of time range (ISO 8601)"
                },
                {
                  "disabled": false,
                  "key": "to",
                  "value": "<dateTime>",
                  "description": "(Required) End of time range (ISO 8601)"
                },
                {
                  "disabled": false,
                  "key": "resolution",
                  "value": "<string>",
                  "description": "Data resolution for aggregation"
                }
              ],
              "variable": [
                {
                  "disabled": false,
                  "type": "any",
                  "value": "<string>",
                  "key": "pointId",
                  "description": "(Required) Unique identifier of the building data point"
